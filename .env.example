DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-esta-chave-antes-de-publicar
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Para desenvolvimento local, deixe como sqlite.
DB_ENGINE=sqlite

# Produção com PostgreSQL:
DB_NAME=connecttalk
DB_USER=connecttalk
DB_PASSWORD=defina-uma-senha-forte
DB_HOST=db
DB_PORT=5432

# Trava de segurança dos disparos de campanha: "dry_run" (padrão, nunca envia nada
# de verdade) ou "test" (só envia para os números liberados por empresa em
# Admin > Empresas > "números de teste"). Não existe modo "live" separado — é o
# "test" que passa a enviar de verdade (só pra allowlist) quando um provedor real
# estiver configurado abaixo.
WHATSAPP_SEND_MODE=dry_run

# Provedor de envio: "mock" (padrão, nunca faz chamada de rede) ou "meta_cloud".
# As três variáveis abaixo só importam se WHATSAPP_PROVIDER=meta_cloud — e mesmo
# assim, só chegam a ser usadas em WHATSAPP_SEND_MODE=test, restrito à allowlist.
# Veja "Integrando um provedor real de WhatsApp" no README antes de preencher.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

